<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Seitentitel - Website</title>
    <meta name="description" content="Kurze Beschreibung der Seite.">
    <link rel="stylesheet" href="style.css">    <!--style.css einbinden wenn es erstellt wurde-->
</head>
<body>
    <header>
        <button onclick="ganzeSeiteVorlesen()">Ganze Seite vorlesen</button>


        <a href="/">Startseite</a>
        <button id="menuButtonMain">Menue oeffnen/schliessen</button>
        <nav aria-label="Hauptnavigation">...navi
            <ul>
                <li><a href="buttonfield.html">buttonfield</a></li>
                <li><a href="leistungen.html">Leistungen</a></li>
                <li><a href="Kontakt.html">Kontakt</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <form action="" method="get" id="listboxmain">
            <select name="ziel" onchange="window.location.href=this.value">
                <option value="">-- Bitte wählen --</option>
                <option value="buttonfield.html">-- Buttonfield --</option>
                <option value="leistungen.html">-- Leistungen --</option>
                <option value="Kontakt.html">-- Kontakt --</option>
                <option value="impressum.html">-- Impressum --</option>
            </select>
    <main class="layout-container">
        <!-- SEITE 1: INDEX -->
        <div id="index" class="seite aktiv">
        </form>
        <h1>Hauptueberschrift</h1>
        <figure>
            <img src="bildki.webp"
                          alt = "Ich teilte der KI mit sie solle mir ein Bild für meine erste Homepage machen , nur zu Versuchszwecken. das Kam dabei raus :D "
                          width="1200" 
                          height="800" 
                          loading="lazy"
                          style="max-width: 100%; height: auto;">
            <figcaption>Homepage frontend</figcaption>
        </figure>
       
        <p>Inhalt der Seite</p>
        </div>

        <!-- SEITE 2: BUTTONFIELD -->
        <div id="buttonfield" class="seite">
        <h4 style="text-align: center; margin-bottom: 20px;" >Buttonfield for ever</h4>
    
         <div class="layout-container-buttonfield">
          <h1 style="text-align: center; margin-bottom: 20px;">Iiiiiihhh bims</h1> 

           <div class="links">
            <input type="text" id="eingabename"></input>
            <label>  Bitte Geben Sie Ihren Namen ein </label>
            <button id="ein-button" onclick="document.getElementById('nav-liste').classList.toggle('anzeigen')">Menu öffnen/schliessen</button>
            <form>
             <select id="nav-liste" class="versteckte-liste" onchange="window.location.href=this.value">
                <option value="">-- Bitte wählen --</option>
                <option value="buttonfield.html">-- Buttonfield --</option>
                <option value="leistungen.html">-- Leistungen --</option>
                <option value="Kontakt.html">-- Kontakt --</option>
                <option value="impressum.html">-- Impressum --</option>
             </select>
            </form>
           </div>
           <div class="rechts">
            <button id="zweibutton" class="mein-button" onclick="document.getElementById('grade').classList.toggle('anzeigen')">hier bin ich</button>
            <select id="grade" class="versteckte-liste" ></select>
           </div>
          </div>
        </div>

        <!-- SEITE 3: LEISTUNGEN -->
        <div id="leistungen" class="seite">
         <h1>Leistungen</h1> 

         <button id="menuButton">Menü öffnen/schliessen</button>

         <div id="listbox">
           <ul> 
            <li><a href="">-- Bitte wählen --</a></li>
            <li><a href="index.html">-- Startseite --</a></li>
            <li><a href="buttonfield.html">-- Buttonfield --</a></li>
            <li><a href="leistungen.html">-- Leistungen --</a></li>
            <li><a href="Kontakt.html">-- Kontakt --</a></li>
            <li><a href="impressum.html">-- Impressum --</a></li>
           </ul>
         </div>
          <!-- Die Buttons zum Steuern (hier fängt der funtionierende code an)--> 
          <button onclick="umschalten('meineListe')">Liste zeigen/verstecken</button>
          <button onclick="umschalten('meineListbox')">Listbox zeigen/verstecken</button>

          <br><br>

          <!-- Die Elemente, die ein- und ausgeblendet werden sollen -->
          <ul id="meineListe">
           <li>Erster Punkt</li>
           <li>Zweiter Punkt</li>
          </ul>

          <select id="meineListbox">
           <option>Option 1</option>
           <option>Option 2</option>
          </select>
        </div>

        <!-- SEITE 4: KONTAKT -->
        <div id="kontakt" class="seite">
         <h1>Kontakt</h1> 
         <br>
         <form action="/kontakt" method="post">

          <div>
            <Label>Bitte geben Sie hier Ihre Nachricht ein*:</Label>
            <br>
            <textarea id="kontaktarea" name="kontaktarea" cols=35 rows=5 placeholder="Bitte geben Sie hier Ihren Text ein..." required></textarea>
            <br>
          </div>
        
          <div>
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" autocomplete="off" required>
          </div>
            
          <div>
            <label for="email">E-Mail*</label>
            <input id="email" name="email" type="email" autocomplete="off" required>
          </div>
          <button>submit</button>
        
         </form>
        </div>

        <!-- SEITE 5: IMPRESSUM -->
        <div id="impressum" class="seite">
         <h1>Impressum</h1>         
        <aside>
         <h2>Related</h2>
         <div id="ausgabe" style="white-space: pre-line;"></div>
         <script>const message = `Hier entsteht (k)ein mehrzeiliger Text mit Javascript
                 welcher eventuell wichtige Hinweise über den Standort
                 oder CEO liefert.
      
                 `
                 console.log(message)
                 document.write(message)
                 document.getElementById('ausgabe').innerText = message;</script>

            <!-- aside content in here -->
        </aside>
        <h4>Wir danken recht herzlich für Ihren Besuch auf unserer Seite. <br>
            Wir hoffen es hat Ihnen gefallen und wünschen noch einen angenehmen Tag. <br>

            Auf Wiedersehen.</h4>
        </div>

        <!-- SEITE 6: SPIELSTART -->
        <div id="spielstart" class="seite">

        <!-- Spieleranmeldungsbildschirm -->
        <!-- 2 Spieler und startbutton -->
        <


        </div>

        <!-- SEITE 7: BACKGAMMON -->
        <div id="backgammon" class="seite">
        
        <button id="open-rules">Anleitung anzeigen</button>
        <!--Das native Pop-up-Fenster-->
        <dialog id="rules-modal">
         <h2>Backgammon Regeln</h2>
         <p> Hier kommen die Spielregeln hin...</p>
         <button id="close-rules">Schließen</button>
        </dialog>

        <!--Spielfeld und SpielSpaß-->
        <!--Würfelgrafik (und Logik,js)-->
        <!--anzeige/ermittlung welcher spieler dran ist und ziehen darf , fals es nachdem würfel und jenachdem wie die steine liegen überhaupt ziehen kann-->
        </div>

        <!-- SEITE 8: SPIELENDE -->
        <div id="spielende" class="seite">
        <!--Endergebnis holen , Gewinner anzeigen
        <!-- Spielergebniss und neustart , zurück zu backgammon  bei gleichen namen , bei neuen spielern zurück zu spielstart-->
       
        <script src=script.js></script>                
    </main>
    <footer>
        <a href="impressum.html">impressum</a>
    </footer>
</body>

</html>
   
